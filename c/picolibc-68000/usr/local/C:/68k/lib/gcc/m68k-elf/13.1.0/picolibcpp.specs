%rename link	picolibc_link
%rename cpp	picolibc_cpp
%rename cc1	picolibc_cc1
%rename cc1plus	picolibc_cc1plus

*cpp:
-isystem %{-picolibc-prefix=*:%*/include/; -picolibc-buildtype=*:/usr/local/include/%*; :/usr/local/include} -isystem %{-picolibc-prefix=*:%*/include/../m68k-elf/include/c++/%(version)/m68k-elf/%M; -picolibc-buildtype=*:/usr/local/include/%*/../m68k-elf/include/c++/%(version)/m68k-elf/%M; :/usr/local/include/../m68k-elf/include/c++/%(version)/m68k-elf/%M} %{-printf=*: -D_PICOLIBC_PRINTF='%*'} %{-scanf=*: -D_PICOLIBC_SCANF='%*'} %(picolibc_cpp)

*cc1:
  %(picolibc_cc1) 

*cc1plus:
-isystem %{-picolibc-prefix=*:%*/include/; -picolibc-buildtype=*:/usr/local/include/%*; :/usr/local/include} -isystem %{-picolibc-prefix=*:%*/include/../m68k-elf/include/c++/%(version)/m68k-elf/%M; -picolibc-buildtype=*:/usr/local/include/%*/../m68k-elf/include/c++/%(version)/m68k-elf/%M; :/usr/local/include/../m68k-elf/include/c++/%(version)/m68k-elf/%M}   %(picolibc_cc1plus)  

*link:
%{DPICOLIBC_DOUBLE_PRINTF_SCANF:--defsym=vfprintf=__d_vfprintf} %{DPICOLIBC_DOUBLE_PRINTF_SCANF:--defsym=vfscanf=__d_vfscanf} %{DPICOLIBC_FLOAT_PRINTF_SCANF:--defsym=vfprintf=__f_vfprintf} %{DPICOLIBC_FLOAT_PRINTF_SCANF:--defsym=vfscanf=__f_vfscanf} %{DPICOLIBC_LONG_LONG_PRINTF_SCANF:--defsym=vfprintf=__l_vfprintf} %{DPICOLIBC_LONG_LONG_PRINTF_SCANF:--defsym=vfscanf=__l_vfscanf} %{DPICOLIBC_INTEGER_PRINTF_SCANF:--defsym=vfprintf=__i_vfprintf} %{DPICOLIBC_INTEGER_PRINTF_SCANF:--defsym=vfscanf=__i_vfscanf} %{DPICOLIBC_MINIMAL_PRINTF_SCANF:--defsym=vfprintf=__m_vfprintf} %{DPICOLIBC_MINIMAL_PRINTF_SCANF:--defsym=vfscanf=__m_vfscanf} -L%{-picolibc-prefix=*:%*/lib; -picolibc-buildtype=*:/usr/local/lib/%*; :/usr/local/lib} %{-printf=*:--defsym=vfprintf=__%*_vfprintf} %{-scanf=*:--defsym=vfscanf=__%*_vfscanf} %{!T:-Tpicolibcpp.ld} %(picolibc_link) --gc-sections --build-id=none

*lib:
--start-group %(libgcc)  -lc %{-oslib=*:-l%*} --end-group

*endfile:
crtend%O%s

*startfile:
%{-picolibc-prefix=*:%*/lib/%{-crt0=*:crt0-%*%O; :crt0%O}; -picolibc-buildtype=*:/usr/local/lib/%*/%{-crt0=*:crt0-%*%O; :crt0%O}; :/usr/local/lib/%{-crt0=*:crt0-%*%O; :crt0%O}} crtbegin%O%s

